<Window x:Class="Poe2Overlay.App.JanelaConfiguracoes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações — Pit Overlay's"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="True"
        FontFamily="Segoe UI">
  <StackPanel x:Name="Conteudo" Margin="22,18,22,20">
    <!-- Atalhos -->
    <TextBlock Text="Atalhos" FontSize="16" FontWeight="SemiBold" />
    <TextBlock Text="Clique no campo e aperte a combinação de teclas." FontSize="12" Opacity="0.7" Margin="0,2,0,10" />

    <TextBlock Text="Consultar o item sob o mouse (copia e abre o overlay)" FontSize="13" Margin="0,0,0,4" />
    <TextBox x:Name="TxtAtalhoConsultar" IsReadOnly="True" IsReadOnlyCaretVisible="False" FontSize="14" />

    <TextBlock Text="Mostrar / ocultar o overlay" FontSize="13" Margin="0,12,0,4" />
    <TextBox x:Name="TxtAtalhoAlternar" IsReadOnly="True" IsReadOnlyCaretVisible="False" FontSize="14" />

    <CheckBox x:Name="ChkCopiaAvancada" Margin="0,12,0,0"
              Content="Cópia avançada (Ctrl+Alt+C): traz tiers e faixas dos mods" />
    <TextBlock Text="Se os detalhes do item ficarem presos na tela do jogo depois do atalho, desmarque (usa Ctrl+C, sem Alt)."
               FontSize="11.5" Opacity="0.6" TextWrapping="Wrap" Margin="28,0,0,0" />

    <!-- Mercado -->
    <TextBlock Text="Mercado" FontSize="16" FontWeight="SemiBold" Margin="0,22,0,8" />
    <TextBlock Text="Liga padrão" FontSize="13" Margin="0,0,0,4" />
    <ComboBox x:Name="CmbLiga" HorizontalAlignment="Stretch" />

    <TextBlock Text="Quando mudar moeda, liga, mods ou mín/máx" FontSize="13" Margin="0,14,0,4" />
    <RadioButton x:Name="RbBuscaAutomatica" Content="Buscar de novo na hora" GroupName="Busca" />
    <RadioButton x:Name="RbBuscaManual" Content="Esperar eu clicar em Buscar (economiza buscas)" GroupName="Busca" />

    <!-- Aparência -->
    <TextBlock Text="Aparência" FontSize="16" FontWeight="SemiBold" Margin="0,22,0,8" />
    <TextBlock Text="Esquema de cores do overlay" FontSize="13" Margin="0,0,0,4" />
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="150" />
      </Grid.ColumnDefinitions>
      <ComboBox x:Name="CmbEsquema" HorizontalAlignment="Stretch" />
      <!-- Amostra do esquema escolhido -->
      <Border x:Name="Amostra" Grid.Column="2" CornerRadius="5" BorderThickness="1" Padding="10,5">
        <StackPanel>
          <TextBlock x:Name="AmostraTitulo" Text="Pit Overlay's" FontWeight="SemiBold" FontSize="13" />
          <TextBlock x:Name="AmostraTexto" Text="~1 divine" FontSize="12" />
        </StackPanel>
      </Border>
    </Grid>

    <Grid Margin="0,14,0,4">
      <TextBlock Text="Transparência do fundo" FontSize="13" />
      <TextBlock x:Name="TxtTransparencia" FontSize="13" HorizontalAlignment="Right" Opacity="0.8" />
    </Grid>
    <Slider x:Name="SldTransparencia" Minimum="0" Maximum="70" TickFrequency="5" IsSnapToTickEnabled="True" />
    <TextBlock Text="O texto continua nítido; só o fundo fica mais ou menos transparente." FontSize="11.5" Opacity="0.6" />

    <TextBlock Text="Onde o overlay abre num item novo" FontSize="13" Margin="0,14,0,4" />
    <RadioButton x:Name="RbCursor" Content="Ao lado do item (perto do mouse)" GroupName="Abrir" />
    <RadioButton x:Name="RbFixa" Content="Onde eu deixei (arraste o overlay pelo título)" GroupName="Abrir" />

    <TextBlock x:Name="TxtErro" Foreground="#FFE07A5F" FontSize="13" TextWrapping="Wrap" Margin="0,14,0,0" Visibility="Collapsed" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button x:Name="BtnSalvar" Content="Salvar" MinWidth="100" />
      <Button x:Name="BtnCancelar" Content="Cancelar" MinWidth="100" Margin="8,0,0,0" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
